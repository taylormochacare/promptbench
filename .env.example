# Greptile MCP — Claude Code (.mcp.json) primary; also .cursor/mcp.json + .codex/config.toml
# export GREPTILE_API_KEY=your_key_from_app.greptile.com

# Optional: Cursor Team Admin API key for Bugbot Admin API (not the personal crsr_ key)
# export CURSOR_API_KEY=your_team_admin_key

# Supabase (validated by src/lib/env.ts — see docs/environment.md).
# Real values go in .env.local (gitignored). Publishable key is client-safe;
# RLS is the boundary. Never put the service_role or sb_secret key anywhere.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
